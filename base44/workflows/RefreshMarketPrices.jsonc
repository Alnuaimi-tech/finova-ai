{
  "name": "Refresh Market Prices",
  "description": "Refresh the non-UAE market quotes used by FINOVA every ten minutes; UAE data is displayed through TradingView widgets.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "refresh_market_prices",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "batch_zero": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getMarketData",
            "args": {
              "batch": 0
            }
          },
          "then": "pause_one",
          "x-base44": {
            "title": "Refresh ETFs and crypto"
          }
        }
      },
      {
        "pause_one": {
          "wait": "PT20S",
          "then": "batch_one",
          "x-base44": {
            "title": "Provider cooldown"
          }
        }
      },
      {
        "batch_one": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getMarketData",
            "args": {
              "batch": 1
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh forex and stocks"
          }
        }
      }
    ]
  }
}