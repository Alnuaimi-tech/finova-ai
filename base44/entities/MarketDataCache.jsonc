{
  "name": "MarketDataCache",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "quotes": {
      "type": "object",
      "additionalProperties": true
    },
    "attempts": {
      "type": "object",
      "additionalProperties": true
    },
    "issues": {
      "type": "object",
      "additionalProperties": true
    },
    "budget_day": {
      "type": "string"
    },
    "credits_used": {
      "type": "number"
    },
    "lease_until": {
      "type": "number"
    },
    "lease_token": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}